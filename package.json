    "pdf:publish": "node scripts/generate-pdfs.mjs --output-dir public/pdfs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "cmdk": "1.1.1",
    "geist": "^1.7.2",
