    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "chokidar": "^4.0.3",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
