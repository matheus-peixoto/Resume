{
  "name": "cv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "resume:discover": "node scripts/discover-resumes.mjs",
    "predev": "pnpm resume:discover",
    "dev": "next dev",
    "prebuild": "node scripts/clean-build-cache.mjs && node scripts/discover-resumes.mjs",
    "build": "next build",
    "prestart": "pnpm resume:discover",
    "start": "next dev",
    "lint": "next lint",
    "pdf:install": "playwright install chromium",
    "pdf:dev": "node scripts/generate-pdfs.mjs --watch",
